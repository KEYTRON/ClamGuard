<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <!-- Content Container -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_navigation_custom">

        <!-- Tab 1: Dashboard (Home) -->
        <ScrollView
            android:id="@+id/tab_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_title"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/card_hero"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/hero_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hero_title_default"
                            android:textColor="@color/text_on_dark"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hero_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/hero_message_default"
                            android:textColor="@color/text_on_dark_soft"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/protection_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/pill_pending"
                            android:paddingLeft="12dp"
                            android:paddingTop="6dp"
                            android:paddingRight="12dp"
                            android:paddingBottom="6dp"
                            android:text="@string/chip_pending"
                            android:textColor="@color/chip_text"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_clamguard" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/threat_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/threat_headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/threat_headline_default"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/threat_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/threat_summary_idle"
                        android:textColor="@color/text_soft"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/threat_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/threat_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/threat_empty"
                        android:textColor="@color/text_soft"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/background_monitor_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/background_monitor_disabled"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <!-- Tab 2: Scan (Radar) -->
        <ScrollView
            android:id="@+id/tab_scan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Сканирование"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/card_surface"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/scan_mode_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/pill_pending"
                            android:paddingLeft="10dp"
                            android:paddingTop="4dp"
                            android:paddingRight="10dp"
                            android:paddingBottom="4dp"
                            android:text="@string/scan_mode_ready"
                            android:textColor="@color/chip_text"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/status_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/status_idle"
                            android:textColor="@color/text_soft"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/scan_progress_percent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/progress_percent_waiting"
                            android:textColor="@color/text_secondary"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.keytron.clamguard.RadarView
                        android:id="@+id/radar_view"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginStart="14dp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/scan_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/scan_progress_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/progress_ready_idle"
                    android:textColor="@color/text_soft"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/quick_scan_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/button_primary"
                    android:text="@string/quick_scan_button"
                    android:textColor="@color/button_primary_text" />

                <Button
                    android:id="@+id/full_scan_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/button_secondary"
                    android:text="@string/full_scan_button"
                    android:textColor="@color/accent" />

                <Button
                    android:id="@+id/selective_scan_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/button_secondary"
                    android:text="@string/selective_scan_button"
                    android:textColor="@color/accent" />

                <Button
                    android:id="@+id/update_db_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/button_secondary"
                    android:text="@string/update_db_button"
                    android:textColor="@color/accent" />
            </LinearLayout>
        </ScrollView>

        <!-- Tab 3: Settings -->
        <ScrollView
            android:id="@+id/tab_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Настройки"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/check_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/button_secondary"
                    android:text="Проверить готовность движка"
                    android:textColor="@color/accent" />

                <!-- Quarantine Button -->
                <Button
                    android:id="@+id/settings_quarantine_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/button_primary"
                    android:text="@string/settings_quarantine_button"
                    android:textColor="@color/button_primary_text" />

                <!-- Permissions Center -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Центр разрешений"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView android:id="@+id/settings_root_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Root: Проверка..." android:textColor="@color/text_soft" android:textSize="14sp"/>
                    <Button android:id="@+id/settings_request_root_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/button_secondary" android:text="Запросить Root" android:textColor="@color/accent" android:textSize="12sp"/>

                    <TextView android:id="@+id/settings_notifications_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Уведомления: ..." android:textColor="@color/text_soft" android:textSize="14sp"/>
                    <Button android:id="@+id/settings_notifications_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/button_secondary" android:text="Разрешить уведомления" android:textColor="@color/accent" android:textSize="12sp"/>

                    <TextView android:id="@+id/settings_files_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Доступ к файлам: ..." android:textColor="@color/text_soft" android:textSize="14sp"/>
                    <Button android:id="@+id/settings_files_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/button_secondary" android:text="Разрешить доступ ко всем файлам" android:textColor="@color/accent" android:textSize="12sp"/>

                    <TextView android:id="@+id/settings_overlay_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Поверх окон: ..." android:textColor="@color/text_soft" android:textSize="14sp"/>
                    <Button android:id="@+id/settings_overlay_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/button_secondary" android:text="Разрешить поверх приложений" android:textColor="@color/accent" android:textSize="12sp"/>

                    <TextView android:id="@+id/settings_admin_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Администратор: ..." android:textColor="@color/text_soft" android:textSize="14sp"/>
                    <Button android:id="@+id/settings_admin_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/button_secondary" android:text="Активировать админа" android:textColor="@color/accent" android:textSize="12sp"/>
                </LinearLayout>

                <!-- Appearance -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Внешний вид"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView android:id="@+id/settings_theme_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Текущая тема: системная" android:textColor="@color/text_soft" android:textSize="14sp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                        <Button android:id="@+id/settings_theme_system_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Системная" android:textSize="10sp" android:textColor="@color/accent" android:background="@drawable/button_secondary"/>
                        <Button android:id="@+id/settings_theme_light_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Светлая" android:textSize="10sp" android:textColor="@color/accent" android:background="@drawable/button_secondary"/>
                        <Button android:id="@+id/settings_theme_dark_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Тёмная" android:textSize="10sp" android:textColor="@color/accent" android:background="@drawable/button_secondary"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Language -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Язык приложения"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView android:id="@+id/settings_language_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Текущий язык: системный" android:textColor="@color/text_soft" android:textSize="14sp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                        <Button android:id="@+id/settings_language_system_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="System" android:textSize="10sp" android:textColor="@color/accent" android:background="@drawable/button_secondary"/>
                        <Button android:id="@+id/settings_language_ru_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Русский" android:textSize="10sp" android:textColor="@color/accent" android:background="@drawable/button_secondary"/>
                        <Button android:id="@+id/settings_language_en_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="English" android:textSize="10sp" android:textColor="@color/accent" android:background="@drawable/button_secondary"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Engine Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Статус системы"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:columnCount="2"
                        android:rowCount="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/tile_surface"
                            android:orientation="vertical"
                            android:padding="10dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Root" android:textSize="11sp" android:textColor="@color/text_muted"/>
                            <TextView android:id="@+id/root_status_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unknown" android:textStyle="bold" android:textColor="@color/text_secondary"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/tile_surface"
                            android:orientation="vertical"
                            android:padding="10dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Модуль" android:textSize="11sp" android:textColor="@color/text_muted"/>
                            <TextView android:id="@+id/module_status_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unknown" android:textStyle="bold" android:textColor="@color/text_secondary"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/tile_surface"
                            android:orientation="vertical"
                            android:padding="10dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Базы" android:textSize="11sp" android:textColor="@color/text_muted"/>
                            <TextView android:id="@+id/database_status_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unknown" android:textStyle="bold" android:textColor="@color/text_secondary"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/tile_surface"
                            android:orientation="vertical"
                            android:padding="10dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Последний скан" android:textSize="11sp" android:textColor="@color/text_muted"/>
                            <TextView android:id="@+id/last_scan_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unknown" android:textStyle="bold" android:textColor="@color/text_secondary"/>
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>

                <!-- Config -->
                <LinearLayout
                    android:id="@+id/settings_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Конфигурация"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <EditText android:id="@+id/clamscan_path" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="clamscan path" android:textSize="14sp" android:textColor="@color/text_secondary" android:textColorHint="@color/text_muted" android:layout_marginTop="8dp"/>
                    <EditText android:id="@+id/database_path" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="database path" android:textSize="14sp" android:textColor="@color/text_secondary" android:textColorHint="@color/text_muted" android:layout_marginTop="4dp"/>
                    <EditText android:id="@+id/target_path" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="target path" android:textSize="14sp" android:textColor="@color/text_secondary" android:textColorHint="@color/text_muted" android:layout_marginTop="4dp"/>

                    <CheckBox
                        android:id="@+id/auto_update_checkbox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Автообновление баз"
                        android:textColor="@color/text_secondary" />

                    <Button
                        android:id="@+id/save_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/button_secondary"
                        android:text="Сохранить пути"
                        android:textColor="@color/accent" />

                    <TextView android:id="@+id/settings_ignored_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Игнорируемые угрозы: 0" android:textColor="@color/text_soft" android:textSize="13sp"/>
                    <Button android:id="@+id/settings_clear_ignored_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/button_secondary" android:text="Очистить список игнорирования" android:textColor="@color/accent" android:textSize="12sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/log_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/tile_surface"
                    android:padding="10dp"
                    android:text="Лог движка появится здесь..."
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Custom Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottom_navigation_custom"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:elevation="8dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/nav_home_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?android:attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_home" android:tint="@color/accent"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Главная" android:textSize="10sp" android:textColor="@color/accent" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_scan_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?android:attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_scan" android:tint="@color/text_muted"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Сканер" android:textSize="10sp" android:textColor="@color/text_muted"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_settings_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?android:attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_settings" android:tint="@color/text_muted"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Настройки" android:textSize="10sp" android:textColor="@color/text_muted"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
