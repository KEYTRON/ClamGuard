<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_surface"
    android:padding="16dp">

    <TextView
        android:id="@+id/item_threat_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Threat Name"
        android:textColor="@android:color/holo_red_dark"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/item_original_path"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="/path/to/file"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginTop="4dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/item_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2026-03-30 12:00"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginTop="2dp"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btn_restore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_restore"
            android:background="@drawable/button_secondary"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_delete"
            android:background="@drawable/button_primary"
            android:textColor="@android:color/white" />
    </LinearLayout>
</LinearLayout>